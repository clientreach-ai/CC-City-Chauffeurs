# The API. Baked into the build, and the build reads published content from it,
# so it must be the production API's public address — reachable from wherever
# the site is built — for a production build.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Where the photographs managed in the admin are served from, including any path
# prefix — the API's R2_PUBLIC_BASE_URL and R2_PREFIX joined,
# e.g. https://media.city-chauffeurs.com/city-chauffeurs. The image
# optimiser refuses every other host.
MEDIA_URL=

# Must match the API's REVALIDATE_SECRET. Required for a production build.
REVALIDATE_SECRET=
