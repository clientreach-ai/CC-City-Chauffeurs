# Postgres. Either a hosted database (Neon, Supabase, RDS) or a local one:
#   docker run -d --name cc-postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_USER=postgres -e POSTGRES_DB=city_chauffeurs \
#     -p 5432:5432 postgres:17-alpine
#
# On a hosted database, prefer sslmode=verify-full over sslmode=require. They
# behave identically on today's `pg`, but v9 will quietly weaken `require` to
# libpq semantics — no certificate verification. Quote the value: the query
# string contains an ampersand.
DATABASE_URL="postgresql://user:password@host/db?sslmode=verify-full"

# Sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Origins allowed to call this API, comma separated: the website, then the admin.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# The website, and where cache purges are sent.
SITE_URL=http://localhost:3001
# This API's own public address.
API_URL=http://localhost:3000

# Cloudflare R2 — where every photograph is stored and served from.
#
# An API token with object read and write on the bucket. The public base URL
# is the bucket's r2.dev address or a custom domain in front of it, with no
# trailing slash. The bucket may be shared with other projects: everything
# this site stores sits under R2_PREFIX (default "city-chauffeurs"), and
# nothing outside it is ever listed, written or deleted.
R2_ACCOUNT_ID=
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# R2_PREFIX=city-chauffeurs

# Shared with the website. Lets a publish show on the site at once rather than
# within the minute. Generate with: openssl rand -hex 24
REVALIDATE_SECRET=

# WhatsApp, answered by the assistant. All optional: left unset, the channel
# is disabled and no webhook is mounted, so an existing deployment boots
# exactly as before.
#
#   disabled   — the default. /api/whatsapp/* does not exist.
#   twilio     — the real channel. Twilio posts to WHATSAPP_WEBHOOK_URL.
#   simulator  — the same pipeline with a small JSON format of its own, for
#                a developer's machine. Posts go to /api/whatsapp/simulator.
# WHATSAPP_PROVIDER=disabled
#
# The exact public address the provider posts to, path included. Required for
# Twilio, which signs the address it was given — behind a proxy that is not
# the one the server hears, so it is set here rather than worked out. The
# simulator signs only the body and falls back to API_URL.
# WHATSAPP_WEBHOOK_URL=https://citychauffeursapi.clientreach.ai/api/whatsapp/twilio
#
# Our WhatsApp number, in E.164. A message addressed to any other number is
# ignored.
# WHATSAPP_NUMBER=+442084433332
#
# Required when WHATSAPP_PROVIDER=twilio — the server refuses to start
# without them.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
#
# Signs posts to the simulator (header X-Simulator-Signature). Required
# wherever the simulator can be reached; at least 16 characters. The
# simulator is refused outright in production.
# WHATSAPP_SIMULATOR_SECRET=
#
# The model behind the assistant: OpenAI, through the Responses API.
# "scripted" needs no key and answers from a fixed script — for local runs
# only, and refused when NODE_ENV=production.
# WHATSAPP_AI_PROVIDER=openai
#
# Any model the Responses API serves. It must take the reasoning parameter
# unless WHATSAPP_AI_EFFORT=none.
# WHATSAPP_AI_MODEL=gpt-5.4-mini
#
# How much the model may think before answering: none, low, medium, high.
# A WhatsApp reply is short, so low is the default.
# WHATSAPP_AI_EFFORT=low
#
# Required when WHATSAPP_AI_PROVIDER=openai. Give the key a spend limit on
# the OpenAI dashboard: it is the only ceiling on what a busy month costs.
# OPENAI_API_KEY=

# Email. Left unset, nothing is sent and the server behaves exactly as it did
# before there was any email at all.
#
#   off     — the default.
#   smtp    — any mail server, including a Gmail account with an app
#             password. For trying it out, not for production: a personal
#             mailbox has daily limits and a reputation of its own.
#   resend  — the transactional service, for production.
# MAIL_PROVIDER=off
#
# Required for smtp. Port 587 is STARTTLS, 465 is TLS throughout.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
#
# Required for resend.
# RESEND_API_KEY=
#
# Who it comes from, and who hears that somebody is waiting. Both required
# once a provider is set. Gmail rewrites the address to the account's own, so
# only the display name is yours to choose there.
# MAIL_FROM=City Chauffeurs <bookings@citychauffeurs.co.uk>
# OFFICE_EMAIL=
#
# Where the admin lives, so an alert can link straight to the record.
# ADMIN_URL=https://cc-city-chauffeurs-admin-ochre.vercel.app
