{
  "name": "CC-City-Chauffeurs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @CC-City-Chauffeurs/db --",
    "db:studio": "turbo run db:studio -F @CC-City-Chauffeurs/db --",
    "db:generate": "turbo run db:generate -F @CC-City-Chauffeurs/db --",
    "db:migrate": "turbo run db:migrate -F @CC-City-Chauffeurs/db --"
  },
  "dependencies": {
    "@CC-City-Chauffeurs/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@CC-City-Chauffeurs/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.3.0"
}
